DATABASE_URL=postgres://postgres:postgres@localhost:5432/url_shortener
REDIS_URL=redis://localhost:6379
PORT=3000
# Public origin used to build short links in API responses
BASE_URL=http://localhost:3000

# Token for the /urls management endpoints (update, delete, stats).
# Leave empty to switch those endpoints off.
ADMIN_TOKEN=

# Set this when running behind a proxy/load balancer so click locations use the
# visitor's IP, e.g. 1 (one proxy hop). Leave unset when running directly.
# TRUST_PROXY=1

# How long a redirect target stays cached, in seconds (default 3600)
# CACHE_TTL_SECONDS=3600

# Optional: comma-separated domains that can't be shortened (subdomains included)
# BLOCKED_DOMAINS=evil.example,phish.test

# Optional: SEPARATE database + Redis for `npm test`. The tests wipe the tables
# and FLUSH that Redis database, so never point these at real data.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/url_shortener_test
# TEST_REDIS_URL=redis://localhost:6379/15

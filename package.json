{
  "name": "linkforge",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "bench": "node --env-file-if-exists=.env scripts/bench.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "geoip-lite": "^2.0.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "autocannon": "^8.0.0"
  }
}
